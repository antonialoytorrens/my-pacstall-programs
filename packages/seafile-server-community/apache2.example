# Example Apache config for a seafile-server-community stack; copy into
# /etc/apache2/sites-available/ by hand (a2enmod proxy proxy_http proxy_wstunnel rewrite headers).

<VirtualHost *:80>
    ServerName seafile.example.com

    LimitRequestBody 10737418240

    Alias /media /opt/seafile/seahub-data/media
    Alias /static /opt/seafile/seafile-server-latest/seahub/seahub/media/assets

    <Directory /opt/seafile/seahub-data/media>
        Require all granted
    </Directory>
    <Directory /opt/seafile/seafile-server-latest/seahub/seahub/media/assets>
        Require all granted
    </Directory>

    ProxyPreserveHost On
    ProxyTimeout 1200

    ProxyPass /media !
    ProxyPass /static !

    # /seafhttp strips its prefix before reaching seaf-server, same as the
    # nginx rewrite - the upstream only ever sees paths below its own root.
    ProxyPass /seafhttp http://127.0.0.1:8082 timeout=36000
    ProxyPassReverse /seafhttp http://127.0.0.1:8082

    ProxyPass /notification http://127.0.0.1:8083 upgrade=websocket
    ProxyPassReverse /notification http://127.0.0.1:8083

    ProxyPass / http://127.0.0.1:49081/
    ProxyPassReverse / http://127.0.0.1:49081/

    RequestHeader set X-Forwarded-Proto "http"
</VirtualHost>
