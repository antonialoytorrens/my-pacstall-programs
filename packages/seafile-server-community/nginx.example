# Example nginx config for a seafile-server-community stack; copy into
# /etc/nginx/sites-available/ by hand.

server {
    listen 80;
    server_name seafile.example.com;

    client_max_body_size 10g;

    location / {
        proxy_pass http://127.0.0.1:49081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1200s;
    }

    location /media {
        alias /opt/seafile/seahub-data/media;
    }

    location /static {
        alias /opt/seafile/seafile-server-latest/seahub/seahub/media/assets;
    }

    location /seafhttp {
        rewrite ^/seafhttp(.*)$ $1 break;
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 36000s;
        proxy_request_buffering off;
    }

    location /notification {
        proxy_pass http://127.0.0.1:8083;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
