# /opt/seafile/conf/seafile.conf
# Generated by dbconfig-common (ucf-tracked). `dpkg-reconfigure seafile-server-community`
# to change the DB connection.

[fileserver]
host = 0.0.0.0
port = 8082
use_go_fileserver = true

[database]
type = mysql
create_tables = true
host = _DBC_DBSERVER_
port = _DBC_DBPORT_
user = _DBC_DBUSER_
password = _DBC_DBPASS_
db_name = _DBC_DBNAME_

[library_trash]
expire_days = 30
