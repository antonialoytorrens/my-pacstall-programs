[Unit]
Description=Seahub (Seafile web UI, Gunicorn WSGI server)
After=network.target seafile-server.service mariadb.service mysql.service
Requires=seafile-server.service
Wants=mariadb.service mysql.service

[Service]
Type=simple
User=seafile
Group=seafile
WorkingDirectory=/opt/seafile/seafile-server-latest/seahub
Environment=PYTHONPATH=/opt/seafile/seafile-server-latest/seahub
Environment=DJANGO_SETTINGS_MODULE=seahub.settings
Environment=SEAFILE_CENTRAL_CONF_DIR=/opt/seafile/conf
Environment=SEAFILE_CONF_DIR=/opt/seafile/seafile-data
Environment=CCNET_CONF_DIR=/opt/seafile/conf
EnvironmentFile=/opt/seafile/conf/.env
ExecStart=/opt/seafile/seafile-server-latest/seahub/venv/bin/gunicorn seahub.wsgi:application \
    --preload --bind 127.0.0.1:49081 --workers 5 --timeout 300
Restart=on-failure

[Install]
WantedBy=multi-user.target
