# Weblate environment for systemd EnvironmentFile and postinst (bash source).
# Active lines are used by /etc/weblate/weblate_settings.py; comment unused ones.
# Values with spaces or shell metacharacters must be single-quoted.

# --- Core (required) ---
# Django SECRET_KEY (alphanumeric; filled on first configure)
WEBLATE_SECRET_KEY=__SECRETKEY_PLACEHOLDER__
# Public site hostname (SITE_DOMAIN / WebAuthn RP ID)
WEBLATE_DOMAIN=@WEBLATE_DOMAIN@
# Local gunicorn bind port
WEBLATE_HTTP_PORT=@WEBLATE_HTTP_PORT@
# Redis/Valkey URL for Celery broker and result backend
WEBLATE_VALKEY_URL=redis://127.0.0.1:6379/0
# Allow public account registration (1/0)
WEBLATE_REGISTRATION_OPEN=1
# Django settings module name
DJANGO_SETTINGS_MODULE=weblate_settings
# Where weblate_settings.py lives
PYTHONPATH=/etc/weblate

# --- Database (written by postinst / dbconfig-common) ---
#WEBLATE_DB_NAME=weblate
#WEBLATE_DB_USER=weblate
#WEBLATE_DB_PASSWORD=
#WEBLATE_DB_HOST=
#WEBLATE_DB_PORT=

# --- Site / admins ---
# Site title in the UI header
#WEBLATE_SITE_TITLE=Weblate
# Extra ALLOWED_HOSTS (comma-separated); domain is always included
#WEBLATE_ALLOWED_HOSTS=
# Admin name for Django ADMINS (optional; no account is auto-created)
#WEBLATE_ADMIN_NAME=Weblate Admin
# Admin email for Django ADMINS / error mails (optional)
#WEBLATE_ADMIN_EMAIL=admin@@WEBLATE_DOMAIN@

# --- Access control ---
# Require login for all pages (1/0)
#WEBLATE_REQUIRE_LOGIN=0
# Use captcha on registration (1/0)
#WEBLATE_REGISTRATION_CAPTCHA=1

# --- HTTPS / reverse proxy ---
# Tell Weblate it is served over HTTPS (1/0)
#WEBLATE_ENABLE_HTTPS=1
# Redirect HTTP to HTTPS inside Django (usually leave 0 behind a proxy)
#WEBLATE_SECURE_SSL_REDIRECT=0
# Header used for client IP when behind a proxy
#WEBLATE_IP_PROXY_HEADER=HTTP_X_FORWARDED_FOR
# SECURE_PROXY_SSL_HEADER as name,value
#WEBLATE_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# --- Email (dummy backend until SMTP is set) ---
# Django email backend dotted path
#WEBLATE_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP host
#WEBLATE_EMAIL_HOST=smtp.example.com
# SMTP port
#WEBLATE_EMAIL_PORT=587
# SMTP username
#WEBLATE_EMAIL_HOST_USER=
# SMTP password
#WEBLATE_EMAIL_HOST_PASSWORD=
# Use TLS (1/0)
#WEBLATE_EMAIL_USE_TLS=1
# Use SSL (1/0)
#WEBLATE_EMAIL_USE_SSL=0
# Envelope From for application mail
#WEBLATE_DEFAULT_FROM_EMAIL=noreply@@WEBLATE_DOMAIN@
# From address for server error mails
#WEBLATE_SERVER_EMAIL=noreply@@WEBLATE_DOMAIN@

# --- Debugging / logging ---
# Django DEBUG (1/0)
#WEBLATE_DEBUG=0
# Logging level (DEBUG/INFO/WARNING/ERROR)
#WEBLATE_LOGLEVEL=INFO
# Time zone (e.g. Europe/Madrid)
#WEBLATE_TIME_ZONE=UTC

# --- Content Security Policy (space-separated extras) ---
#WEBLATE_CSP_SCRIPT_SRC=
#WEBLATE_CSP_IMG_SRC=
#WEBLATE_CSP_CONNECT_SRC=
#WEBLATE_CSP_STYLE_SRC=
#WEBLATE_CSP_FONT_SRC=

# --- Rate limiting ---
# Auth attempt limit before lockout
#WEBLATE_RATELIMIT_ATTEMPTS=5
# Lockout duration in seconds
#WEBLATE_RATELIMIT_LOCKOUT=300
# Sliding window in seconds
#WEBLATE_RATELIMIT_WINDOW=300
