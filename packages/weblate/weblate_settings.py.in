DEFAULT_FROM_EMAIL = _env("WEBLATE_DEFAULT_FROM_EMAIL", f"noreply@{_domain}")
SERVER_EMAIL = _env("WEBLATE_SERVER_EMAIL", f"noreply@{_domain}")

REGISTRATION_OPEN = _env_bool("WEBLATE_REGISTRATION_OPEN", True)
REGISTRATION_CAPTCHA = _env_bool("WEBLATE_REGISTRATION_CAPTCHA", True)
REQUIRE_LOGIN = _env_bool("WEBLATE_REQUIRE_LOGIN", False)

AUTHENTICATION_BACKENDS = (
    "social_core.backends.email.EmailAuth",
