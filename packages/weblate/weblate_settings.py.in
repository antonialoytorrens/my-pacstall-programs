EMAIL_HOST_USER = _env("WEBLATE_EMAIL_HOST_USER", "")
EMAIL_HOST_PASSWORD = _env("WEBLATE_EMAIL_HOST_PASSWORD", "")
EMAIL_USE_TLS = _env_bool("WEBLATE_EMAIL_USE_TLS", True)
