import os
from weblate.settings_example import *  # noqa: F401,F403


def _env(name, default=""):
    return os.environ.get(name, default)


def _env_bool(name, default=False):
    raw = os.environ.get(name)
    if raw is None:
        return default
    return raw.strip().lower() in ("1", "true", "yes", "on")


def _env_list(name, default=None):
    raw = os.environ.get(name, "")
    if not raw.strip():
        return list(default or [])
    return [item.strip() for item in raw.split(",") if item.strip()]


def _env_csp(name, default):
    raw = os.environ.get(name, "")
    if not raw.strip():
        return list(default)
    return list(default) + [item.strip() for item in raw.split() if item.strip()]


SECRET_KEY = _env("WEBLATE_SECRET_KEY", "__SECRETKEY_PLACEHOLDER__")

DATABASES = {
    "default": {
        "ENGINE": "django.db.backends.postgresql",
        "NAME": _env("WEBLATE_DB_NAME", "weblate"),
        "USER": _env("WEBLATE_DB_USER", "weblate"),
        "PASSWORD": _env("WEBLATE_DB_PASSWORD", ""),
        "HOST": _env("WEBLATE_DB_HOST", ""),
        "PORT": _env("WEBLATE_DB_PORT", ""),
    }
}

_domain = _env("WEBLATE_DOMAIN", "@WEBLATE_DOMAIN@")
SITE_DOMAIN = _domain
SITE_TITLE = _env("WEBLATE_SITE_TITLE", "Weblate")

_allowed = _env_list("WEBLATE_ALLOWED_HOSTS")
ALLOWED_HOSTS = list(dict.fromkeys([_domain, *_allowed]))

DATA_DIR = "/var/lib/weblate"
CACHE_DIR = "/var/cache/weblate"

_valkey = _env("WEBLATE_VALKEY_URL", "redis://127.0.0.1:6379/0")
CELERY_BROKER_URL = _valkey
CELERY_RESULT_BACKEND = _valkey

TIME_ZONE = _env("WEBLATE_TIME_ZONE", "UTC")

DEBUG = _env_bool("WEBLATE_DEBUG", False)
if "WEBLATE_LOGLEVEL" in os.environ:
    try:
        LOGGING["loggers"]["weblate"]["level"] = _env("WEBLATE_LOGLEVEL", "INFO")
    except (NameError, KeyError, TypeError):
        pass

_admin_name = _env("WEBLATE_ADMIN_NAME", "Weblate Admin")
_admin_email = _env("WEBLATE_ADMIN_EMAIL", "")
if _admin_email:
    ADMINS = ((_admin_name, _admin_email),)

