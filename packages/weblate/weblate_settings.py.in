ENABLE_HTTPS = _env_bool("WEBLATE_ENABLE_HTTPS", True)
SECURE_SSL_REDIRECT = _env_bool("WEBLATE_SECURE_SSL_REDIRECT", False)
SESSION_COOKIE_SECURE = ENABLE_HTTPS
CSRF_COOKIE_SECURE = ENABLE_HTTPS

_proxy_ssl = _env("WEBLATE_SECURE_PROXY_SSL_HEADER", "HTTP_X_FORWARDED_PROTO,https")
_proxy_parts = [part.strip() for part in _proxy_ssl.split(",", 1)]
if len(_proxy_parts) == 2:
    SECURE_PROXY_SSL_HEADER = (_proxy_parts[0], _proxy_parts[1])

IP_BEHIND_REVERSE_PROXY = True
if "WEBLATE_IP_PROXY_HEADER" in os.environ:
    IP_PROXY_HEADER = _env("WEBLATE_IP_PROXY_HEADER")

SECURE_HSTS_SECONDS = 31536000 if ENABLE_HTTPS else 0
SECURE_HSTS_INCLUDE_SUBDOMAINS = ENABLE_HTTPS
SECURE_HSTS_PRELOAD = ENABLE_HTTPS

OTP_WEBAUTHN_RP_ID = _domain
OTP_WEBAUTHN_RP_NAME = SITE_TITLE
OTP_WEBAUTHN_ALLOWED_ORIGINS = [f"https://{_domain}"]

CSP_SCRIPT_SRC = _env_csp("WEBLATE_CSP_SCRIPT_SRC", ["'self'", "'unsafe-inline'"])
CSP_IMG_SRC = _env_csp("WEBLATE_CSP_IMG_SRC", ["'self'", "data:"])
CSP_CONNECT_SRC = _env_csp("WEBLATE_CSP_CONNECT_SRC", ["'self'"])
CSP_STYLE_SRC = _env_csp("WEBLATE_CSP_STYLE_SRC", ["'self'", "'unsafe-inline'"])
CSP_FONT_SRC = _env_csp("WEBLATE_CSP_FONT_SRC", ["'self'"])

if "WEBLATE_RATELIMIT_ATTEMPTS" in os.environ:
    RATELIMIT_ATTEMPTS = int(_env("WEBLATE_RATELIMIT_ATTEMPTS", "5"))
