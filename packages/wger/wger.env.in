SECRET_KEY=__SECRETKEY_PLACEHOLDER__
JWT_PRIVATE_KEY=__JWTPRIVATE_PLACEHOLDER__
JWT_PUBLIC_KEY=__JWTPUBLIC_PLACEHOLDER__

WGER_HTTP_PORT=@WGER_HTTP_PORT@

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_DATABASE=@WGER_DB_NAME@
DJANGO_DB_USER=@WGER_DB_USER@
DJANGO_DB_HOST=@WGER_DB_HOST@
DJANGO_DB_PORT=5432

SITE_URL=https://@WGER_DOMAIN@
CSRF_TRUSTED_ORIGINS=https://@WGER_DOMAIN@
TIME_ZONE=UTC

DJANGO_DEBUG=False
DJANGO_MEDIA_ROOT=/var/lib/wger/media
DJANGO_STATIC_ROOT=/var/lib/wger/static

DJANGO_SETTINGS_MODULE=settings.main
PYTHONPATH=/opt/wger/src

USE_CELERY=False
CELERY_BROKER=redis://127.0.0.1:6379/2
CELERY_BACKEND=redis://127.0.0.1:6379/2
